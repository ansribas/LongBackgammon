<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ansribas.LongBackgammon</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>LongBackgammon</name>
  <summary>Classic Long Backgammon Board Game</summary>

  <description>
    <p>
      Long Backgammon is a popular variant of backgammon played with fifteen checkers
      on a standard board. Players compete to move all their checkers into the home board
      and bear them off first, following strict strategic rules and smart positioning.
    </p>
  </description>

  <developer id="io.github.ansribas">
    <name>Aleksey Svetlov</name>
  </developer>

  <url type="homepage">https://github.com/ansribas/LongBackgammon</url>
  <url type="bugtracker">https://github.com/ansribas/LongBackgammon/issues</url>
  <url type="vcs-browser">https://github.com/ansribas/LongBackgammon</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/ansribas/LongBackgammon/main/data/screenshots/01.png</image>
      <caption>Classic match and gameplay</caption>
      <caption xml:lang="ru">Игровой процесс и партия на доске</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/ansribas/LongBackgammon/main/data/screenshots/02.png</image>
      <caption>Game settings, visual themes, and audio preferences</caption>
      <caption xml:lang="ru">Настройки игры, тем оформления и параметров партии</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/ansribas/LongBackgammon/main/data/screenshots/03.png</image>
      <caption>Interactive rules guide and match scoring</caption>
      <caption xml:lang="ru">Интерактивный справочник правил и условий победы</caption>
    </screenshot>
  </screenshots>

  <categories>
    <category>Game</category>
    <category>BoardGame</category>
  </categories>

  <provides>
    <id>io.github.ansribas.LongBackgammon.desktop</id>
  </provides>
  <launchable type="desktop-id">io.github.ansribas.LongBackgammon.desktop</launchable>

  <branding>
    <color type="primary" scheme_preference="light">#e66100</color>
    <color type="primary" scheme_preference="dark">#e66100</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.5" date="2026-10-30">
      <description>
        <p>Configurable board side selection (Left / Right) with smooth transitions, animated checker collection into trays, panel docking sound effects, hidden stats reset trigger, and rolloff flow enhancements.</p>
      </description>
    </release>
    <release version="1.0" date="2026-10-25">
      <description>
        <p>Initial release of Long Backgammon for Linux.</p>
      </description>
    </release>
  </releases>
</component>
